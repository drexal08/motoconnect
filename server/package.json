{
  "name": "motoconnect-server",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "MotoConnect API — real-time moto-taxi matching for Rwanda (Postgres/PostGIS, Express, Socket.IO)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "//start": "Migrations run first so a deploy can never serve code against an older schema. Both migration files are safe to re-run.",
    "start": "node dist/db/migrate.js && node dist/index.js",
    "start:no-migrate": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:verify": "tsx src/db/verify.ts",
    "db:verify:prod": "node dist/db/verify.js",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:admin": "tsx src/db/seedAdmin.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
