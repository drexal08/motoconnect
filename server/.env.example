# ─── MotoConnect server configuration ────────────────────────────────────────

# HTTP server
PORT=4000
NODE_ENV=development

# PostgreSQL + PostGIS (required; PostGIS extension must be enabled on the DB)
DATABASE_URL=postgres://postgres:MotoConn3ct!2026@localhost:5432/motoconnect

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=30

# SMS gateway for OTP delivery.
# Not configured yet (open question): in non-production environments the code is
# logged to the server console and returned in the devCode field so flows are testable.
SMS_PROVIDER=none

# ─── PayPack (MTN MoMo + Airtel Money via paypack.rw) ─────────────────────────
# Get credentials at https://paypack.me (agents dashboard). Sandbox mode uses
# PAYPACK_WEBHOOK_MODE=sandbox and sandbox keys.
# Leave empty to run in TEST mode: payments are simulated end-to-end with no
# real money movement (a fake cashin is completed ~8s after purchase).
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=
PAYPACK_WEBHOOK_SECRET=
PAYPACK_WEBHOOK_MODE=sandbox
# Public URL PayPack must be able to reach for webhook delivery
# (e.g. https://xxxx.ngrok-free.app). In test mode this is unused.
PAYPACK_WEBHOOK_URL=

# Google Maps JS API key (client-side; also set VITE_GOOGLE_MAPS_API_KEY in the
# frontend .env.local). Restrict this key in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Sweeper interval (ms) for claim/confirmation expiry checks
SWEEP_INTERVAL_MS=5000
