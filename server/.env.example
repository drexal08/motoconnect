# ─── MotoConnect server configuration ────────────────────────────────────────

# HTTP server
PORT=4000
NODE_ENV=development

# PostgreSQL + PostGIS (required; PostGIS extension must be enabled on the DB)
#   local:  postgres://postgres:password@localhost:5432/motoconnect
#   Neon:   Dashboard → Connect → pooled connection string
#           postgres://<user>:<password>@ep-xxx-pooler.<region>.aws.neon.tech/motoconnect?sslmode=require
#
# Neon is the recommended host: its compute scales to zero after 5 minutes idle
# and wakes automatically on the next connection, with no dashboard click. That
# is why it replaced Supabase here — a paused Supabase free project needs a
# human to restore it.
# TLS is enabled automatically for any non-localhost host. Override with
# DATABASE_SSL=true / false only if your setup genuinely differs.
DATABASE_URL=postgres://postgres:MotoConn3ct!2026@localhost:5432/motoconnect
DATABASE_POOL_MAX=10

# Browser origins allowed to call this API, comma-separated. Required in
# production — without it the API answers whichever origin asks.
# e.g. https://motoconnect.rw,https://www.motoconnect.rw,https://ops.motoconnect.rw
WEB_ORIGINS=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=30

# SMS gateway for OTP delivery.
#
# THIS IS THE ONE THING THAT BLOCKS A REAL LAUNCH. With SMS_PROVIDER=none the
# verification codes that gate the consumer app are written to the server log
# and sent to nobody, so passengers and riders cannot sign in in production.
# Development is unaffected: the code comes back in the devCode field.
#
# Every option costs money — Firebase Phone Auth needs the Blaze plan with
# billing attached (no free SMS allowance since Sept 2024), and Twilio,
# Africa's Talking and local Rwandan aggregators all price per message.
# Implement one in server/src/services/smsService.ts, then set this.
SMS_PROVIDER=none

# ─── PayPack (MTN MoMo + Airtel Money via paypack.rw) ─────────────────────────
# Get credentials at https://paypack.me (agents dashboard). Sandbox mode uses
# PAYPACK_WEBHOOK_MODE=sandbox and sandbox keys.
# Leave empty to run in TEST mode: payments are simulated end-to-end with no
# real money movement (a fake cashin is completed ~8s after purchase).
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=
PAYPACK_WEBHOOK_SECRET=
PAYPACK_WEBHOOK_MODE=sandbox
# Public URL PayPack must be able to reach for webhook delivery
# (e.g. https://xxxx.ngrok-free.app). In test mode this is unused.
PAYPACK_WEBHOOK_URL=

# Google Maps JS API key (client-side; also set VITE_GOOGLE_MAPS_API_KEY in the
# frontend .env.local). Restrict this key in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Sweeper interval (ms) for claim/confirmation expiry checks
SWEEP_INTERVAL_MS=5000

# ─── Ops console (admin) ──────────────────────────────────────────────────────
# Login identifier for the seed super_admin created on first boot.
# This is an IDENTIFIER, not a credential: no password is ever seeded, and
# access to this inbox only ever yields a one-time setup link.
ADMIN_SEED_EMAIL=byiringirinnocent8@gmail.com

# Where the ops console is served. Used to build the setup link that is emailed.
# Deploy it on its own host in production (spec §2.4) — never at
# motoconnect.rw/admin, and never linked from a public page.
#   dev:  http://localhost:3000/admin.html
#   prod: https://ops.motoconnect.rw
ADMIN_CONSOLE_URL=http://localhost:3000/admin.html
# Extra CORS origin when the console is served from that separate subdomain.
ADMIN_ORIGIN=

# One-time setup token lifetime (ms). Default 24 h.
ADMIN_SETUP_TOKEN_TTL_MS=86400000

# ─── Transactional email (Postmark) ───────────────────────────────────────────
# Delivers the admin setup links.
# POSTMARK_SERVER_TOKEN is the *Server* token (Servers → your server → API
# Tokens), NOT the Account token — the account token returns ErrorCode 10.
# EMAIL_FROM must be a verified Sender Signature, or on a verified domain,
# or Postmark rejects the send with ErrorCode 400.
# Leave the token empty in development: the email is printed to the server
# console instead, and the code always reports that it was NOT delivered.
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=MotoConnect Ops <ops@motoconnect.rw>
POSTMARK_MESSAGE_STREAM=outbound

# ─── Rider verification documents ─────────────────────────────────────────────
# Cloudflare R2 holds the ID / licence / plate photographs in production.
# REQUIRED on any host without a persistent disk (Render's free plan has none):
# without it the images go to local disk and are destroyed on every deploy,
# leaving database rows pointing at files that no longer exist.
#
# R2's free tier is 10 GB with zero egress charges and no expiry, and buckets
# are private unless you explicitly publish them. Do NOT connect a public
# r2.dev domain or a custom domain to this bucket — these are photographs of
# national ID cards, and the app reads them server-side with these keys.
#   Cloudflare dashboard → R2 → Manage API tokens → Create (Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rider-documents

# Supabase Storage remains supported as an alternative driver. R2 wins if both
# are set. Leave these empty unless you deliberately prefer Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=rider-documents

# Local fallback, used only when the two Supabase values above are empty.
# Must be OUTSIDE any static route — nothing serves this directory; the images
# are readable only through an authenticated admin endpoint.
UPLOAD_DIR=uploads
# Per-image ceiling. The client downscales before upload, so this is a backstop.
UPLOAD_MAX_BYTES=3145728
# How long images are kept after a verification decision, in days. These are the
# most sensitive records the platform holds — confirm this figure against
# Rwandan data-protection guidance before going live.
RIDER_DOCUMENT_RETENTION_DAYS=365

# ─── Refunds ──────────────────────────────────────────────────────────────────
# OFF by default, deliberately. PayPack exposes cashin/cashout but no reversal
# of a specific transaction, so a refund is a NEW outbound disbursement that
# needs a funded float. Only switch this on once that payout path is confirmed
# with PayPack — until then every refund is recorded and paid out by hand, and
# the console says so on screen rather than implying the money already moved.
PAYPACK_REFUND_ENABLED=false
