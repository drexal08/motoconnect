# Frontend environment (gitignored — never commit this file).
# Copy to .env.local for development, and set these in the Vercel dashboard for
# production. Everything here ships to the browser: never put a secret in it.

# Where the API lives.
#   development — leave empty; Vite proxies /api and /socket.io to localhost:4000
#   production  — the full origin of the API service, e.g. https://motoconnect-api.onrender.com
# Both the REST calls and the Socket.IO connection use this. It cannot be a
# Vercel rewrite, because a rewrite cannot proxy a WebSocket upgrade.
VITE_API_URL=

# Google Maps JS API key (PRD §8.1). Restrict this key in Google Cloud Console
# to your domain/referrer. Without it the consumer map shows a designed empty state.
VITE_GOOGLE_MAPS_API_KEY=

# The ops console (admin.html) does NOT need this key — its map runs on Leaflet
# and OpenStreetMap tiles, so live ops keeps working even if the Google billing
# account lapses or this variable is missed on the ops host.
